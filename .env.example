# ==========================================
# إعدادات نماذج الذكاء الاصطناعي (AI Providers)
# ==========================================
# المزود الافتراضي: gemini | openai | claude_cli | ollama | mock
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash

# مفتاح Google Gemini API (الخيار الرئيسي)
GEMINI_API_KEY=your_gemini_api_key_here

# مفاتيح اختيارية للمزودين الآخرين
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ==========================================
# إعدادات البريد الإلكتروني (SMTP & IMAP)
# ==========================================
# وضع المحاكاة الآمنة (true = لا يتم إرسال إيميلات فعلية، بل تسجل في النظام للمعاينة)
DRY_RUN=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@domain.com
SMTP_PASSWORD=your_app_password_here
SENDER_NAME=أحمد | فريق تطوير الأعمال
SENDER_EMAIL=your_email@domain.com

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your_email@domain.com
IMAP_PASSWORD=your_app_password_here

# ==========================================
# إعدادات النظام وقاعدة البيانات
# ==========================================
DATABASE_PATH=data/sales_agent.db
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
CALENDAR_BOOKING_LINK=https://calendly.com/your-org/intro-call
